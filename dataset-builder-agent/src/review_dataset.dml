% ============================================================================
% Table Review
% ============================================================================
%
% Asks the LLM to check the candidate type inference selected for every table
% in dataset/papers/, and writes the verdicts to papers/PMC<id>/review.jsonl and
% one page per table, papers/PMC<id>/final_tableN.html, with the outcome.
%
% The review works from papers/PMC<id>/type_inference.jsonl, which
% review_agent.sh writes first. For each table the model sees the cells, merged
% cells, label, caption and notes and the one selected parse, but no other
% candidates and no types. table_review.pl then decides:
%   - it confirms the parse           -> valid, with that candidate
%   - its own boundary is a candidate -> valid, with that candidate
%   - another boundary, or none       -> unparseable
%   - the parser found no candidate   -> unparseable, without asking
%   - no usable answer after a retry  -> unreviewed (never counted as unparseable)
%
% For every valid table whose selected candidate is labelable, the geometric
% certificate of that candidate is written to papers/PMC<id>/ as well
% (certificateN_hH_vV.pl or certificateN_layoutK.pl); the build writes none,
% and certificates of candidates the review did not select are removed.
%
% Each table gets a fresh LLM call (prompt/2: no earlier conversation and no
% tools), so verdicts cannot influence one another.
%
% Finally, without the LLM, table_export.pl writes papers/PMC<id>/final_tables.json
% for every paper with a current review: each valid table as subtables with
% nested horizontal and vertical metadata, unmerged data and the residual corner.
%
% Parameters (deepclause run ... -P key=value), all optional:
%   papers=PMC123,PMC456   review only these papers
%   run=<name>             review only the papers selected by the build run
%                          dataset/runs/<name> (run_agent.sh passes this)
%   force=true             review again even when review.jsonl is current
%   model=<provider:model> the model in use, recorded in each review; pass the
%                          same value as --model (review_agent.sh does this)
%   dataset=<dir>          the dataset to review, a directory relative to the
%                          workspace (default dataset)
%   tables=<uid,uid>       send only these tables (PMC<id>/t<index>); the other
%                          tables of a queued paper are recorded as not_selected
%
% Run from the directory that holds the .pl files:
%   deepclause run review_dataset.dml --headless
%
% ============================================================================

% Loaded through a search-path alias so the module runs as compiled Prolog;
% see dataset_builder.dml.
user:file_search_path(workspace, '/workspace').
:- use_module(workspace(table_review)).
:- use_module(workspace(table_export)).

agent_main :-
    ( param(dataset, Dataset0) -> true ; Dataset0 = none ),
    review_dataset_dir("/workspace", Dataset0, Dataset),
    (   param(run, Run)
    ->  review_run_papers(Dataset, Run, Papers)
    ;   param(papers, Papers)
    ->  true
    ;   Papers = none
    ),
    ( param(force, Force) -> true ; Force = none ),
    ( param(model, Model) -> true ; Model = none ),
    ( param(tables, Tables0) -> true ; Tables0 = none ),
    review_filtered_settings("/workspace", Papers, Tables0, Force, Model, Settings),
    output("Reviewing the selected candidates..."),
    review_queue(Dataset, Settings, Queue, Skipped),
    report_skipped(Skipped),
    review_papers(Queue, Dataset, Settings, Lines),
    (   catch(record_review_run(Dataset, Settings, Lines, Skipped, RunFile),
              Error,
              ( format(string(Warning), "WARNING: could not save the review manifest: ~w", [Error]),
                output(Warning),
                fail ))
    ->  format(string(RunMsg), "Review manifest: ~w", [RunFile]),
        output(RunMsg)
    ;   true
    ),
    % Last stage: every paper with a current review (including those skipped
    % above as up to date) gets final_tables.json. A failure is reported and
    % does not undo the review.
    output("Exporting reviewed tables..."),
    (   catch(export_reviewed_papers(Dataset, Settings, ExportLines),
              ExportError,
              ( format(string(ExportWarning), "WARNING: export failed: ~w", [ExportError]),
                output(ExportWarning),
                fail ))
    ->  report_lines(ExportLines)
    ;   true
    ),
    length(Queue, Reviewed),
    length(Skipped, NumSkipped),
    format(string(Summary),
           "Review complete: ~d paper(s) reviewed, ~d skipped. Verdicts are in dataset/papers/PMC<id>/review.jsonl, structured tables in final_tables.json.",
           [Reviewed, NumSkipped]),
    answer(Summary).

report_lines([]).
report_lines([Line|Lines]) :-
    output(Line),
    report_lines(Lines).

report_skipped([]).
report_skipped([Name-Reason|Rest]) :-
    format(string(Line), "~w: skipped (~w)", [Name, Reason]),
    output(Line),
    report_skipped(Rest).

% review_papers(+Queue, +Dataset, +Settings, -Lines): one status line per
% paper. A failure to write one paper's review is reported and does not stop
% the run.
review_papers([], _, _, []).
review_papers([Paper|Papers], Dataset, Settings, [Line|Lines]) :-
    review_paper_name(Paper, Name),
    review_paper_items(Paper, Items),
    review_items(Items, Results),
    (   catch(publish_paper_review(Dataset, Paper, Settings, Results, Line0),
              Error,
              format(string(Line0), "~w: review not saved (~w)", [Name, Error]))
    ->  Line = Line0
    ;   format(string(Line), "~w: review not saved", [Name])
    ),
    output(Line),
    review_papers(Papers, Dataset, Settings, Lines).

review_items([], []).
review_items([Item|Items], [Result|Results]) :-
    review_item(Item, Result),
    review_items(Items, Results).

review_item(Item, Result) :-
    review_item_action(Item, Action),
    (   Action == ask
    ->  ask_model(Item, 1, Result)
    ;   review_skip_result(Item, Result)
    ).

% ask_model(+Item, +Attempt, -Result): one retry when the answer is missing
% or does not follow the requested format, then review_failed.
ask_model(Item, Attempt, Result) :-
    review_item_prompt(Item, Prompt),
    (   catch(prompt(Prompt, object(Answer)), Error, true)
    ->  ( var(Error) -> Reply = Answer ; Reply = error(Error) )
    ;   Reply = no_answer
    ),
    review_answer(Item, Reply, Attempt, Outcome),
    (   Outcome = done(Result)
    ->  true
    ;   Outcome = retry(_), Attempt < 2
    ->  Next is Attempt + 1,
        ask_model(Item, Next, Result)
    ;   Outcome = retry(Why),
        review_failed_result(Item, Why, Attempt, Result)
    ).
