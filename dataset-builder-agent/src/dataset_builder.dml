% ============================================================================
% Table Dataset Builder
% ============================================================================
%
% Builds a dataset of rasterized, constraint-checked tables from the full
% text of open-access PubMed Central (PMC) papers on a given topic.
%
%   Phase 1 (LLM)    The model searches PMC with search_pmc and picks papers.
%   Phase 2 (no LLM) For each chosen paper: download the full text, pull out
%                    every <table> element, rasterize it with
%                    table_layout_generator.pl, check the raster against
%                    parse_constraints.pl, and color it with
%                    table_annotator.pl. One file is written per table.
%
% The Prolog work runs inside DeepClause's own Prolog engine, through the
% dataset_pipeline module loaded below, so the full text never enters the
% model's context and no external swipl is needed. The only LLM cost is
% Phase 1.
%
% Output (relative to the workspace):
%   dataset/papers/PMC<id>/annotated_tableN.html  one annotated table per file
%   dataset/papers/PMC<id>/metadata.json      article title and table counts
%   dataset/raw/PMC<id>.xml                    validated JATS full text as downloaded
%   dataset/cache/requests/                    temporary per-search responses
%   dataset/cache/.ncbi-last-request          shared request-limiter state
%
% Usage (run from the directory that holds the .pl files):
%   agent_main("CRISPR base editing")
%
% ============================================================================

% --- Table logic ---

% The workspace is mounted at /workspace inside DeepClause's Prolog engine.
% Loading dataset_pipeline.pl through a search-path alias makes it a real
% Prolog module whose predicates (esearch_ids/2, verified_search_lines/3,
% reset_search_provenance/0, filter_search_selected_ids/3,
% download_status/2, pause/1, process_paper/4) run as ordinary compiled Prolog. A plain consult/1, or a
% use_module/1 with a file path, would instead hand the code to DML's
% meta-interpreter, which keeps only the first solution of a clause body.
user:file_search_path(workspace, '/workspace').
:- use_module(workspace(dataset_pipeline)).

% --- Settings ---

% Maximum number of papers processed per run.
max_papers(20).

% NCBI's no-key request budget is shared by all local workers using the
% same workspace. Each request reserves a slot under an OS-atomic directory
% lock; 0.4 seconds is deliberately slower than 3 requests per second.
ncbi_request_gap(0.4).

% If NCBI still answers "API rate limit exceeded", the run pauses and tries
% the same request again, waiting this many seconds before each retry. The
% request fails once the list is used up.
ncbi_retry_waits([2, 5, 10, 20, 30]).

% --- Tool Definitions ---

% The only tool the model can call. Results are short text, never page HTML.
tool(search_pmc(Query, Results),
     "Search PubMed Central for open-access full-text papers. Query uses PubMed search syntax (plain keywords work). Returns up to 15 lines, one per paper: 'PMC<id> | date | journal | title'.") :-
    (   catch(pmc_search(Query, Found), _, fail)
    ->  Results = Found
    ;   Results = "No results (the search failed or matched nothing). Try a simpler query."
    ).

% --- Search (NCBI E-utilities, no LLM) ---

% ESearch and ESummary live in one unique temporary directory per tool
% invocation. The last successful search IDs are retained in the verified
% provenance allowlist, not in shared JSON filenames.
pmc_search(Query, Results) :-
    allocate_search_cache("/workspace", SearchSave, SearchMounted,
                          SummarySave, SummaryMounted),
    setup_call_cleanup(
       true,
       pmc_search_files(Query, SearchSave, SearchMounted,
                        SummarySave, SummaryMounted, Results),
       cleanup_search_cache(SearchMounted)).

pmc_search_files(Query, SearchSave, SearchMounted,
                 SummarySave, SummaryMounted, Results) :-
    format(string(Term), "(~w) AND open access[filter]", [Query]),
    url_encode(Term, EncodedTerm),
    format(string(SearchUrl),
           "https://eutils.ncbi.nlm.nih.gov/entrez/eutils/esearch.fcgi?db=pmc&retmode=json&sort=relevance&retmax=15&term=~w",
           [EncodedTerm]),
    ncbi_fetch(SearchUrl, SearchSave, esearch_json),
    esearch_ids(SearchMounted, Ids),
    Ids \== "",
    format(string(SummaryUrl),
           "https://eutils.ncbi.nlm.nih.gov/entrez/eutils/esummary.fcgi?db=pmc&retmode=json&id=~w",
           [Ids]),
    ncbi_fetch(SummaryUrl, SummarySave, esummary_json),
    verified_search_lines(SearchMounted, SummaryMounted, Results),
    Results \== "".

% --- Non-spinning host waits and shared request reservations (F14) ---
%
% The Prolog module runs inside DeepClause's WebAssembly runtime, where
% sleep/1 can throw. exec(bash/1) crosses to the host and suspends the WASM
% engine while an ordinary OS timer waits, rather than burning CPU.
% Python3 is required in the DeepClause host workspace. Commands contain
% *only* fixed literals and validated, formatted numeric values; never
% interpolate a model-provided URL, query, ID or file path into the shell.
% ncbi_wait.py uses the SAME .ncbi-request.lock and .ncbi-last-request files
% as native Prolog's ncbi_rate_limit_at/3, preserving cross-worker spacing.
host_ncbi_reserve(Gap) :-
    ( number(Gap), Gap >= 0.34, Gap =< 60
    -> true
    ;  throw(error(domain_error(ncbi_request_gap_0_34_to_60, Gap),
                   context(host_ncbi_reserve/1, 'Invalid host request spacing'))) ),
    format(string(Command), "python3 ncbi_wait.py reserve dataset/cache ~6f", [Gap]),
    exec(bash(command: Command), Result),
    host_wait_success(Result, "RESERVED").

host_pause(Seconds) :-
    ( number(Seconds), Seconds >= 0, Seconds =< 300
    -> true
    ;  throw(error(domain_error(pause_seconds_0_to_300, Seconds),
                   context(host_pause/1, 'Invalid host wait duration'))) ),
    format(string(Command), "python3 ncbi_wait.py wait ~6f", [Seconds]),
    exec(bash(command: Command), Result),
    host_wait_success(Result, "SLEPT").

host_wait_success(Result, Expected) :-
    ( get_dict(stdout, Result, Stdout),
      normalize_space(string(Marker), Stdout), Marker == Expected
    -> true
    ;  throw(error(host_wait_failed(Expected, Result),
                   context(host_wait_success/2, 'Host wait helper did not report success'))) ).

% --- Downloads (rate-limited) ---

% ncbi_fetch(+Url, +File): validate the downloaded body before trusting it.
% url_fetch does not return an HTTP status to this DML caller; malformed
% JSON, HTML error pages, malformed XML and other invalid responses fail.
% Only known transient rate-limit/server error bodies are retried.
ncbi_fetch(Url, File) :-
    ( sub_string(File, _, _, 0, ".xml") -> Kind = jats_xml
    ; sub_string(File, _, _, _, "esummary") -> Kind = esummary_json
    ; Kind = esearch_json ),
    ncbi_fetch(Url, File, Kind).

ncbi_fetch(Url, File, Kind) :-
    ncbi_retry_waits(Waits),
    ncbi_fetch(Url, File, Kind, Waits).

ncbi_fetch(Url, File, Kind, Waits) :-
    ncbi_request_gap(Gap),
    host_ncbi_reserve(Gap),
    ( exists_file(File) -> delete_file(File) ; true ),
    exec(url_fetch(url: Url, save_to: File), _),
    format(string(MountedFile), "/workspace/~w", [File]),
    download_status(MountedFile, Kind, Status),
    ( Status == ok
    -> true
    ; ( Status == rate_limited ; Status = retryable(_) )
    -> ( Waits = [Wait|MoreWaits]
       -> format(string(Msg), "NCBI transient response (~w); retrying after ~w s", [Status, Wait]),
          output(Msg),
          host_pause(Wait),
          ncbi_fetch(Url, File, Kind, MoreWaits)
       ;  ( exists_file(File) -> delete_file(File) ; true ),
          throw(error(ncbi_download_invalid(Kind, retries_exhausted(Status)),
                      context(ncbi_fetch/2, Url))) )
    ;  ( exists_file(File) -> delete_file(File) ; true ),
       throw(error(ncbi_download_invalid(Kind, Status),
                   context(ncbi_fetch/2, Url)))
    ).

% url_encode(+Text, -Encoded): percent-encode everything except ASCII letters
% and digits, so the model's query can never alter the URL. Non-ASCII
% characters are dropped.
url_encode(Text, Encoded) :-
    string_codes(Text, Codes),
    encode_codes(Codes, EncodedCodes),
    string_codes(Encoded, EncodedCodes).

encode_codes([], []).
encode_codes([C|Cs], Out) :-
    (   C >= 128
    ->  Out = Rest
    ;   code_type(C, alnum)
    ->  Out = [C|Rest]
    ;   Hi is C >> 4,
        Lo is C /\ 15,
        hex_code(Hi, H),
        hex_code(Lo, L),
        Out = [37, H, L|Rest]          % 37 is the code of '%'
    ),
    encode_codes(Cs, Rest).

hex_code(N, Code) :-
    string_codes("0123456789ABCDEF", Hex),
    nth0(N, Hex, Code).

% --- Paper ids ---

% parse_pmc_ids(+Text, +Max, -Ids): the digit part of each PMC id the model
% returned, without duplicates, at most Max of them. Anything that is not
% "PMC" followed by digits is discarded, so model output can only ever name
% a file of the form dataset/raw/PMC<digits>.xml.
parse_pmc_ids(Text, Max, Ids) :-
    split_string(Text, ",;\n ", " \t\r", Parts),
    pmc_numbers(Parts, All),
    list_to_set(All, Unique),
    take(Max, Unique, Ids).

pmc_numbers([], []).
pmc_numbers([Part|Parts], Ids) :-
    (   pmc_number(Part, Id)
    ->  Ids = [Id|Rest]
    ;   Ids = Rest
    ),
    pmc_numbers(Parts, Rest).

pmc_number(Part, Digits) :-
    string_upper(Part, Upper),
    (   string_concat("PMC", Digits, Upper)
    ->  true
    ;   Digits = Upper
    ),
    string_length(Digits, Length),
    Length > 0,
    Length =< 12,
    string_codes(Digits, Codes),
    all_digits(Codes).

all_digits([]).
all_digits([C|Cs]) :-
    C >= 48,                            % '0'
    C =< 57,                            % '9'
    all_digits(Cs).

take(_, [], []) :- !.
take(N, _, []) :- N =< 0, !.
take(N, [X|Xs], [X|Ys]) :-
    N1 is N - 1,
    take(N1, Xs, Ys).

% --- Table pipeline (no LLM) ---

% process_papers(+Ids, -Lines): one status line per paper. Never fails, so a
% bad paper cannot abort the run or trigger the fallback clause.
process_papers([], []).
process_papers([Id|Ids], [Line|Lines]) :-
    (   catch(download_and_process(Id, Result), Error,
              format_paper_failure(Id, "/workspace/dataset", Error, Result))
    ->  Line = Result
    ;   format_paper_failure(Id, "/workspace/dataset", pipeline_goal_failed, Line)
    ),
    output(Line),
    process_papers(Ids, Lines).

% download_and_process(+Id, -Line)
% Id is digits only (see parse_pmc_ids/3). url_fetch saves the full text as
% JATS XML, whose tables use the HTML table model (<table>, <tr>, <td>, <th>,
% colspan, rowspan). process_paper/4 (dataset_pipeline.pl) then does, for
% every table:
%   table_layout_generator.pl  ->  raster
%   parse_constraints.pl       ->  header boundaries that satisfy omni_validate/3
%   table_annotator.pl         ->  the table colored as HMD / VMD / data
% and saves it under dataset/papers/PMC<id>/ after full-paper staging.
% Serializes each PMC ID's raw download and subsequent parsing. The raw
% filename is stable, so holding only the publication lock would be too late.
% setup_call_cleanup ensures that exceptions do not strand the ingest lock.
download_and_process(Id, Line) :-
    acquire_paper_ingest_lock(Id, LockDir),
    setup_call_cleanup(true,
                       download_and_process_locked(Id, Line),
                       release_paper_ingest_lock(LockDir)).

download_and_process_locked(Id, Line) :-
    format(string(Url),
           "https://eutils.ncbi.nlm.nih.gov/entrez/eutils/efetch.fcgi?db=pmc&id=~w",
           [Id]),
    format(string(RawFile), "dataset/raw/PMC~w.xml", [Id]),
    ncbi_fetch(Url, RawFile),
    format(string(MountedRawFile), "/workspace/~w", [RawFile]),
    process_paper(Id, MountedRawFile, "/workspace/dataset", Line).

% --- Main ---

agent_main(Topic) :-
    max_papers(Max),
    reset_search_provenance,

    system("You select research papers for a dataset of tables.
- Use search_pmc to find open-access PubMed Central papers on the topic.
- Prefer original research and systematic reviews, which usually contain data tables.
- Run search_pmc at most 3 times, refining the query only if the results are off-topic.
- Only choose PMC ids that appear in the search results. Never invent an id."),

    format(string(Msg), "Building table dataset for: ~w", [Topic]),
    output(Msg),

    output("Phase 1: Selecting papers..."),
    format(string(SelectTask), "Find papers on '~w' and choose the ~w most relevant ones.
Store their PMC ids as a comma-separated list (for example: PMC123456,PMC234567) in PaperIds.", [Topic, Max]),
    task(SelectTask, string(PaperIds)),

    % Validate against the union of actually displayed search results,
    % *before* applying max_papers: fabricated IDs must not displace real
    % candidates when the model returns more than Max values.
    parse_pmc_ids(PaperIds, 1000000, ProposedIds),
    filter_search_selected_ids(ProposedIds, VerifiedIds, RejectedIds),
    (   RejectedIds == []
    ->  true
    ;   format(string(Warning),
               "Ignoring PMC ids not present in this run's search results: ~w",
               [RejectedIds]),
        output(Warning)
    ),
    take(Max, VerifiedIds, Ids),
    Ids \== [],

    output("Phase 2: Extracting, rasterizing and validating tables..."),
    process_papers(Ids, Lines),

    atomic_list_concat(Lines, "\n", Report),
    format(string(Summary), "Dataset build complete for '~w'. Each paper's tables are in dataset/papers/PMC<id>/.\n~w", [Topic, Report]),
    answer(Summary).

% Fallback
agent_main(Topic) :-
    format(string(Msg), "Could not build a dataset for '~w': no PMC ids verified against this run's search results were selected. Please try a more specific topic or check your connection.", [Topic]),
    answer(Msg).
