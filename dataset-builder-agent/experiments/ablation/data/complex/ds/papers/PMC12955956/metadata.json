      "source_table_html":"<table frame=\"hsides\" rules=\"groups\"><thead><tr><th align=\"left\" rowspan=\"2\" colspan=\"1\">Comparison<\/th><th align=\"center\" rowspan=\"2\" colspan=\"1\">Relative Effect (95% CI)<\/th><th align=\"center\" colspan=\"2\" rowspan=\"1\">Absolute Effect Estimates<\/th><th align=\"center\" rowspan=\"2\" colspan=\"1\">Risk Difference<\/th><th align=\"center\" rowspan=\"2\" colspan=\"1\">Certainty of Evidence<\/th><th align=\"center\" rowspan=\"2\" colspan=\"1\">Narrative Summary<\/th><\/tr><tr><th align=\"left\" rowspan=\"1\" colspan=\"1\">Control<\/th><th align=\"center\" rowspan=\"1\" colspan=\"1\">Intervention<\/th><\/tr><\/thead><tbody><tr><td align=\"left\" colspan=\"7\" rowspan=\"1\">28-d mortality (993 patients in nine RCTs)<\/td><\/tr><tr><td align=\"left\" rowspan=\"1\" colspan=\"1\">Esmolol vs. SOC<\/td><td align=\"center\" rowspan=\"1\" colspan=\"1\">RR, 0.69 (0.56–0.85); 522 patients in six RCTs<\/td><td align=\"center\" rowspan=\"1\" colspan=\"1\">500/1000<\/td><td align=\"center\" rowspan=\"1\" colspan=\"1\">345/1000 (280–425)<\/td><td align=\"center\" rowspan=\"1\" colspan=\"1\">155 fewer per 1000 (95% CI, 220–75 fewer)<\/td><td align=\"center\" rowspan=\"1\" colspan=\"1\"><bold>Moderate<\/bold>(serious inconsistency)<\/td><td align=\"center\" rowspan=\"1\" colspan=\"1\">Esmolol probably reduced 28-d mortality in patients with sepsis<\/td><\/tr><tr><td align=\"left\" rowspan=\"1\" colspan=\"1\">Landiolol vs. SOC<\/td><td align=\"center\" rowspan=\"1\" colspan=\"1\">RR, 1.09 (0.79–1.50); 471 patients in three RCTs<\/td><td align=\"center\" rowspan=\"1\" colspan=\"1\">500/1000<\/td><td align=\"center\" rowspan=\"1\" colspan=\"1\">545/1000 (395–750)<\/td><td align=\"center\" rowspan=\"1\" colspan=\"1\">45 more per 1000 (95% CI, 105 fewer to 250 more)<\/td><td align=\"center\" rowspan=\"1\" colspan=\"1\"><bold>Low<\/bold>(serious inconsistency, serious imprecision)<\/td><td align=\"center\" rowspan=\"1\" colspan=\"1\">Landiolol may not reduce 28-d mortality in patients with sepsis<\/td><\/tr><tr><td align=\"left\" rowspan=\"1\" colspan=\"1\">Landiolol vs. esmolol (indirect)<\/td><td align=\"center\" rowspan=\"1\" colspan=\"1\">RR, 1.57 (1.08–2.30); 0 RCT<\/td><td align=\"center\" colspan=\"3\" rowspan=\"1\">Not estimated<\/td><td align=\"center\" rowspan=\"1\" colspan=\"1\"><bold>Low<\/bold>(serious intransitivity)<\/td><td align=\"center\" rowspan=\"1\" colspan=\"1\">Esmolol may reduce 28-d mortality in patients with sepsis compared with landiolol<\/td><\/tr><tr><td align=\"left\" colspan=\"7\" rowspan=\"1\">ICU length of stay (975 patients in nine RCTs)<\/td><\/tr><tr><td align=\"left\" rowspan=\"1\" colspan=\"1\">Esmolol vs. SOC<\/td><td align=\"center\" rowspan=\"1\" colspan=\"1\">MD, –1.29 (–3.88 to 1.31); 502 patients in six RCTs<\/td><td align=\"center\" rowspan=\"1\" colspan=\"1\">14.7 d<\/td><td align=\"center\" rowspan=\"1\" colspan=\"1\">13.41 (10.82–16.01)<\/td><td align=\"center\" rowspan=\"1\" colspan=\"1\">1.29 lower (95% CI, 3.88 lower to 1.31 higher)<\/td><td align=\"center\" rowspan=\"1\" colspan=\"1\"><bold>Very low<\/bold>(serious methodological limitations, very serious inconsistency, serious imprecision)<\/td><td align=\"center\" rowspan=\"1\" colspan=\"1\">The evidence is uncertain about the effect of esmolol on ICU length of stay<\/td><\/tr><tr><td align=\"left\" rowspan=\"1\" colspan=\"1\">Landiolol vs. SOC<\/td><td align=\"center\" rowspan=\"1\" colspan=\"1\">MD, –0.74 (–5.39 to 3.92); 437 patients in three RCTs<\/td><td align=\"center\" rowspan=\"1\" colspan=\"1\">14.7 d<\/td><td align=\"center\" rowspan=\"1\" colspan=\"1\">13.96 (9.31–18.62)<\/td><td align=\"center\" rowspan=\"1\" colspan=\"1\">0.74 lower (95% CI, 5.39 lower to 3.92 higher)<\/td><td align=\"center\" rowspan=\"1\" colspan=\"1\"><bold>Very low<\/bold>(serious methodological limitations, serious inconsistency, serious imprecision)<\/td><td align=\"center\" rowspan=\"1\" colspan=\"1\">The evidenc