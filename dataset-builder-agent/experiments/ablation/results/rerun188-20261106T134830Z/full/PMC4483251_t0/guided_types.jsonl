ext":"Treatment"},  {"cell_id":4,"text":"Mortality data"},  {"cell_id":5,"text":"High dose steroids (>500 mg hydrocortisone or equivalent dose) in experimental intervention group"},  {"cell_id":8,"text":"Sepsis"},  {"cell_id":9,"text":"MP 30 mg/kg every 6 h for a total of 4 doses"},  {"cell_id":10,"text":"45 days"},  {"cell_id":13,"text":"Severe sepsis"},  {"cell_id":14,"text":"MP bolus 30 mg/kg repeated every 6 h up to a total of 4 doses"},  {"cell_id":15,"text":"14 days and ICU"},  {"cell_id":18,"text":"Sepsis"},  {"cell_id":19,"text":"D 10 mg every 6 h for 4 days"},  {"cell_id":20,"text":"8 weeks"},  {"cell_id":23,"text":"Sepsis"},  {"cell_id":24,"text":"D 3 mg/kg, followed by 1 mg/kg every 6 h for 8 times"},  {"cell_id":25,"text":"16 months"},  {"cell_id":28,"text":"Septic shock"},  {"cell_id":29,"text":"Group A ( n = 14): bolus N 10 μg/kg and a single dose of 30 mg/kg MP and 30 min later: a second dose of 100 μg/kg N Group B: ( n = 15) single bolus of 30 mg/kg MP Group I ( n = 7): 30 μg/kg bolus of N, followed by 30 μg/kg/h for 1 h plus a single dose of 30 mg/kg MP Group II ( n = 7), bolus 30 μg/kg N, followed by 30 μg/kg/h for 1 h without MP Group III ( n = 7): MP, 30 mg/kg"},  {"cell_id":33,"text":"Sepsis"},  {"cell_id":34,"text":"B 0.5 mg/kg every 12 h, during 3 consecutive days"},  {"cell_id":35,"text":"30 days"},  {"cell_id":38,"text":"Septic shock"},  {"cell_id":39,"text":"MP 30 mg/kg per dose every 6 h, four times MP diluted in 50 ml of 5 % dextrose in water"},  {"cell_id":40,"text":"Hospital"},  {"cell_id":43,"text":"Sepsis"},  {"cell_id":44,"text":"Once HC 10 mg/kg iv 30 min prior to starting antibiotic therapy"},  {"cell_id":45,"text":"Not specified"},  {"cell_id":48,"text":"Sepsis"},  {"cell_id":49,"text":"D 16 mg in 4 ml of sterile water intravenously for 4 days"},  {"cell_id":50,"text":"10 days, 40 days, 6 months"},  {"cell_id":53,"text":"Septic shock"},  {"cell_id":54,"text":"Single bolus infusion of either 3 mg/kg D in 100 ml IS or 30 mg/kg of MP in 100 ml IS. If ‘necessary’ repeated once after 4 h"},  {"cell_id":55,"text":"Not specified"},  {"cell_id":58,"text":"Septic shock"},  {"cell_id":59,"text":"Group 1 ( n = 21): MP 30 mg/kg Group 2 ( n = 22): D 6 mg/kg Dose was repeated once in both groups after 4 h if shock persisted"},  {"cell_id":60,"text":"7 days, 14 days and 20 days"},  {"cell_id":63,"text":"Sepsis"},  {"cell_id":64,"text":"D week 1, 0.4 mg/kg/day; week 2, 0.3 mg/kg/day; week 3, 0.2 mg/kg/day; week 4, 0.1 mg/kg/day; week 5, fixed dose 4 mg/day, decreased by 1 mg each week in following weeks a"},  {"cell_id":65,"text":"9 months"},  {"cell_id":68,"text":"Sepsis"},  {"cell_id":69,"text":"MP 30 mg/kg bolus followed by 5 mg/kg/h for 9 h Maximal dose 10 g"},  {"cell_id":70,"text":"14 days"},  {"cell_id":73,"text":"SIRS"},  {"cell_id":74,"text":"D iv 1 mg/kg 3 times/day for 3 days"},  {"cell_id":75,"text":"30 days"},  {"cell_id":76,"text":"Low dose steroids (≤500 mg hydrocortisone or equivalent dose) in experimental intervention group"},  {"cell_id":79,"text":"Septic shock"},  {"cell_id":80,"text":"HC 50 mg every 6 h and FC 50 µg every 24 h Treatment duration 6 days"},  {"cell_id":81,"text":"1 year"},  {"cell_id":84,"text":"Septic shock and cirrhosis"},  {"cell_id":85,"text":"50 mg HC every 6 h. After shock resolution, defined as a MAP > 65 mm Hg without vasopressors for 24 h: dose reduction by 10 mg every 2 days until discontinuation"},  {"cell_id":86,"text":"28 days, ICU and hospital"},  {"cell_id":89,"text":"Septic shock"},  {"cell_id":90,"text":"HC 75 mg every 6 h for 5 or more days. In case of shock reversal after 5 days: for 3 days 150 mg HC, then 75 mg for the next 3 days. Treatment was stopped after 5 days in the absence of shock reversal"},  {"cell_id":91,"text":"28 days"},  {"cell_id":94,"text":"Septic shock"},  {"cell_id":95,"text":"HC bolus of 100 mg, followed by a continuous infusion of 0.18 mg/kg/h. After shock reversal dose reduction to 0.08 mg/kg/h. Dose was kept constant for 6 days. HC was tapered in steps of 24 mg/day after successful treatment of infection or serum [sodium] >155 mmol/l"},  {"cell_id":96,"text":"30 days, 90 days, 1 year and ICU"},  {"cell_id":99,"text":"Septic shock"},  {"cell_id":100,"text":"HC 100 mg every 8 h for 72 h, followed by tapering over 4 days"},  {"cell_id":104,"text":"SIRS with or without sepsis"},  {"cell_id":105,"text":"D 0.2 mg/kg (in a single dose)"},  {"cell_id":106,"text":"7 days"},  {"cell_id":109,"text":"Septic shock"},  {"cell_id":110,"text":"D 0.2 mg/kg given three times at intervals of 36 h"},  {"cell_id":111,"text":"7 and 28 days"},  {"cell_id":114,"text":"Sepsis"},  {"cell_id":115,"text":"HC bolus 200 mg, followed by an infusion rate of 10 mg/h for 7 days"},  {"cell_id":116,"text":"7, 28, 60 days and hospital"},  {"cell_id":119,"text":"Septic shock"},  {"cell_id":120,"text":"HC 50 mg every 6 h for the first 5 days, 50 mg every 12 h for the next 3 days, 50 mg every 24 h for the last 3 days. HC was weaned quicker if shock had resolved"},  {"cell_id":121,"text":"28 days, ICU and hospital"},  {"cell_id":124,"text":"Septic shock"},  {"cell_id":125,"text":"HC 50 mg every 6 h for the first 7 days, 50 mg every 8 h for the next 3 days, 50 mg every 12 h for the next 2 days 50 mg every 24 h for the next 2 days"},  {"cell_id":126,"text":"14 days"},  {"cell_id":129,"text":"Septic shock"},  {"cell_id":130,"text":"HC bolus of 100 mg followed by a continuous infusion of 10 mg/h for 24 h"},  {"cell_id":134,"text":"Septic shock"},  {"cell_id":135,"text":"Group A: bolus 200 mg HC every 24 h during 4 days Group B: continuous HC 200 mg/day during 4 days"},  {"cell_id":139,"text":"Severe sepsis"},  {"cell_id":140,"text":"HC infusion (10 mg/h) for 7 days"},  {"cell_id":141,"text":"ICU and hospital"},  {"cell_id":144,"text":"Sepsis"},  {"cell_id":145,"text":"HC 200 mg loading bolus dose followed by a continuous infusion of 240 mg/24 h for 7 days"},  {"cell_id":146,"text":"7 days"},  {"cell_id":149,"text":"Septic shock"},  {"cell_id":150,"text":"HC (500 mg/50 ml) bolus 50 mg, followed by continuous infusion of 0.18 mg/kg/h. 1 h after cessation of vasopressor support: 0.06 mg/kg/h for 24 h, followed by a reduction of 0.02 mg/kg/h every day"},  {"cell_id":151,"text":"28 days"},  {"cell_id":154,"text":"Severe sepsis"},  {"cell_id":155,"text":"Standard therapy and HC 300 mg/day diluted in 50 ml of IS for 6 days via continuous intravenous infusion. After the study period HC therapy was tapered"},  {"cell_id":156,"text":"Hospital"},  {"cell_id":159,"text":"Sepsis"},  {"cell_id":160,"text":"Chinese herb group: 100 ml Sini decoction b every 24 h for 7 days HC group (GOI): 200 mg HC every 24 h for 7 days"},  {"cell_id":161,"text":"28 days"},  {"cell_id":164,"text":"Sepsis"},  {"cell_id":165,"text":"P 40 mg once daily for a total of 7 days"},  {"cell_id":166,"text":"30 days"},  {"cell_id":169,"text":"Septic shock"},  {"cell_id":170,"text":"HC 50 mg iv bolus every 6 h for 5 days, then tapered to 50 mg iv every 12 h for days 6–8, 50 mg every 24 h for days 9–11, and then stopped"},  {"cell_id":171,"text":"Mortality rate at 28 days in patients who did and did not have RC Overall 28 days, ICU, hospital, 1 year"},  {"cell_id":174,"text":"Sepsis"},  {"cell_id":175,"text":"P iv at 06.00 (5 mg) and 18.00 (2.5 mg) for 10 days"},  {"cell_id":176,"text":"28 days"},  {"cell_id":179,"text":"Sepsis"},  {"cell_id":180,"text":"P iv 3 times a day at 06.00 (10 mg), 14.00 (5 mg), and 22.00 (5 mg) for 10 days"},  {"cell_id":181,"text":"28 days"} ]}
